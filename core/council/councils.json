    "0": {
      "name": "Answer",
      "description": "Direct answer. No personas convened."
    },
    "1": {
      "name": "Specialist",
      "description": "One persona with its audit skill."
    },
    "2": {
      "name": "Council",
      "description": "One council: chair, critic, and up to three specialists chosen by relevance."
    },
    "3": {
      "name": "Cross-council",
      "description": "Product, design and development councils in sequence, then quality review and a final synthesis."
    }
  },

{
  "$comment": "Council definitions. Persona files live in core/council/personas/<council>/<personaId>.json; ids listed under 'agentPersonas' resolve to agents/**/agent.json instead. The referee reads this file to plan sessions; it never generates persona reasoning itself.",
  "version": "2.0.0",
  "limits": {
    "defaultConveneSize": 4,
    "maxConveneSize": 5,
    "fullRosterRequiresOptIn": true,
    "maxChallengesPerPersona": 2,
    "criticMinChallenges": 1
  },
  "tiers": {
    "0": {
      "name": "Answer",
      "description": "Direct answer. No personas convened."
    },
    "1": {
      "name": "Specialist",
      "description": "One persona with its audit skill."
    },
    "2": {
      "name": "Council",
      "description": "One council: chair, critic, and up to three specialists chosen by relevance."
    },
    "3": {
      "name": "Cross-council",
      "description": "Product, design and development councils in sequence, then quality review and a final synthesis."
    }
  },

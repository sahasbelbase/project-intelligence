{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-intelligence.dev/schemas/implementation-contract.schema.json",
  "title": "ImplementationContractData",
  "description": "Payload schema for Implementation Plan and Work Breakdown Structure Contract (Gate G4).",
  "type": "object",
  "required": [
    "workstreamId",
    "assignedAgentRole",
    "phases",
    "tasks",
    "fileOwnership"
  ],
  "properties": {
    "workstreamId": { "type": "string" },
    "assignedAgentRole": { "type": "string" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phaseNumber", "name", "goal"],
        "properties": {
          "phaseNumber": { "type": "integer", "minimum": 0 },
          "name": { "type": "string" },
          "goal": { "type": "string" }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["taskId", "phaseNumber", "title", "assignedAgent", "dependencies", "allowedFiles", "forbiddenFiles", "verificationCommand", "status"],
        "properties": {
          "taskId": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" },
          "phaseNumber": { "type": "integer" },
          "title": { "type": "string" },
          "assignedAgent": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "allowedFiles": { "type": "array", "items": { "type": "string" } },
          "forbiddenFiles": { "type": "array", "items": { "type": "string" } },
          "verificationCommand": { "type": "string" },
          "status": { "type": "string", "enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "BLOCKED", "FAILED"] },
          "evidence": {
            "type": "object",
            "properties": {
              "commandExecuted": { "type": "string" },
              "exitCode": { "type": "integer" },
              "summary": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "fileOwnership": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pathPattern", "exclusiveOwnerRole"],
        "properties": {
          "pathPattern": { "type": "string" },
          "exclusiveOwnerRole": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}

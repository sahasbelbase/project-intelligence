{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-intelligence.dev/schemas/skill-definition.schema.json",
  "title": "SkillDefinition",
  "description": "Schema for canonical, portable AI skill definitions matching Section 6 requirements.",
  "type": "object",
  "required": [
    "skillId",
    "name",
    "purpose",
    "whenToUse",
    "prerequisites",
    "inputs",
    "procedure",
    "expectedOutputs",
    "applicableApprovalGates",
    "failureAndRecovery",
    "verificationCriteria",
    "relevantContractsAndMemory"
  ],
  "properties": {
    "skillId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "purpose": { "type": "string" },
    "whenToUse": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "description"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "procedure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stepNumber", "title", "action"],
        "properties": {
          "stepNumber": { "type": "integer" },
          "title": { "type": "string" },
          "action": { "type": "string" }
        }
      }
    },
    "expectedOutputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "applicableApprovalGates": {
      "type": "array",
      "items": { "type": "string", "enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6"] }
    },
    "failureAndRecovery": {
      "type": "object",
      "required": ["potentialFailures", "recoveryStrategy"],
      "properties": {
        "potentialFailures": { "type": "array", "items": { "type": "string" } },
        "recoveryStrategy": { "type": "string" }
      }
    },
    "verificationCriteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "relevantContractsAndMemory": {
      "type": "object",
      "required": ["contracts", "memoryRecords"],
      "properties": {
        "contracts": { "type": "array", "items": { "type": "string" } },
        "memoryRecords": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "additionalProperties": false
}
